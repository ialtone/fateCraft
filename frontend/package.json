{
  "name": "fatecraft-frontend",
  "private": true,
  "version": "0.1.0-beta.5",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test:activity": "node --test tests/activity-reconciliation.test.mjs",
    "test:campaign-actions": "node --test tests/campaign-actions.test.mjs",
    "test:ending-actions": "node --test tests/ending-actions.test.mjs",
    "test:module-actions": "node --experimental-strip-types --test tests/module-actions.test.mjs",
    "test:receipt-groups": "node --experimental-strip-types --test tests/receipt-groups.test.mjs",
    "test:play-readiness": "node --experimental-strip-types --test tests/play-readiness.test.mjs",
    "test:admin-tabs": "node --experimental-strip-types --test tests/admin-tabs.test.mjs",
    "test:admin-users": "node --experimental-strip-types --test tests/admin-users.test.mjs",
    "test:player-rewards": "node --experimental-strip-types --test tests/player-rewards.test.mjs",
    "test:resources": "node --test tests/conversation-resources.test.mjs",
    "test:dedupe": "node --test tests/request-dedupe.test.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue}\"",
    "test:endings": "node --test tests/endings.test.mjs",
    "test:scroll-pin": "node --experimental-strip-types --test tests/scroll-pin.test.mjs"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
