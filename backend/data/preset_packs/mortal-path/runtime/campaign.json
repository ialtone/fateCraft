      {"path": "inventory", "owner": "campaign", "value_type": "object", "visibility": "player", "storage_projection": "campaign_item_stacks"},
      {"path": "recipes", "owner": "campaign", "value_type": "list", "visibility": "player", "storage_projection": "campaign_known_recipes"},
      {"path": "markets", "owner": "campaign", "value_type": "list", "visibility": "player", "storage_projection": "campaign_market_states"},
      {"path": "world", "owner": "campaign", "value_type": "object", "visibility": "player", "storage_projection": "campaigns"},
