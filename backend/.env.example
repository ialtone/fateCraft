# 服务端
PORT=8081
GIN_MODE=debug

# 开发态写死的玩家 id（MVP 不做登录）
DEV_PLAYER_ID=dev

# PostgreSQL 连接（由你手动接入）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fatecraft?sslmode=disable

# 启动时运行 GORM AutoMigrate（权威 schema 是 scripts/sql/init.sql，生产建议保持 false）
AUTO_MIGRATE=false

# 模板 JSON 文件的数据目录（角色卡/Persona/场景/Prompt 预设/世界书）
# 相对路径基于后端工作目录，默认 backend/data/
DATA_DIR=data

# LLM 默认值（数据库 llm_settings 行存在时会覆盖这里）。
# 当数据库行的 api_key 为空时，使用这里的 key 作为兜底。
LLM_API_KEY=

# 允许的 CORS/WebSocket 来源（逗号分隔）；留空则全放开，仅开发用，生产必须配置
ALLOWED_ORIGINS=

# 日志：级别 debug/info/warn/error；格式 console（开发彩色）/ json（生产结构化）
LOG_LEVEL=info
LOG_FORMAT=console
