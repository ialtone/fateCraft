# ==================== 服务端 ====================
# 后端 HTTP 服务监听端口。
PORT=8081
# Gin 运行模式，可选 debug、release 或 test。
GIN_MODE=debug

# ==================== 数据库 ====================
# PostgreSQL 数据库连接地址。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fatecraft?sslmode=disable

# ==================== 数据目录 ====================
# 判定配置、响应 Schema 和内置挑战材料的根目录。
DATA_DIR=data

# ==================== 跨域与实时通信 ====================
# 允许访问后端的 CORS 和 WebSocket 来源，多个地址用逗号分隔；生产环境必须明确配置。
ALLOWED_ORIGINS=

# ==================== 实例与后台任务 ====================
# 本实例的稳定标识（多实例部署时每个实例不同）。用于生成租约归属：同一实例重启后
# 立即回收自己遗留的租约；其他实例的租约只按过期时间回收。留空使用 主机名:端口。
INSTANCE_ID=
# 后台长期记忆 Worker 的并发数；同一对话由数据库租约互斥，不会并发整理。
MEMORY_WORKER_CONCURRENCY=4
# 已发布挑战只读内容缓存：同时受版本数和估算内存双重限制。2C4G 建议保持默认值。
CHALLENGE_CACHE_MAX_VERSIONS=16
CHALLENGE_CACHE_MAX_MIB=256

# ==================== 日志 ====================
# 日志级别，可选 debug、info、warn 或 error。
LOG_LEVEL=info
# 日志格式，可选 console 或 json；生产环境建议使用 json。
LOG_FORMAT=console

# ==================== 认证与安全 ====================
# 用于加密数据库中的用户/平台 LLM API Key 和 SMTP 密码，至少填写 32 个字符且不可随意更换。
AUTH_DATA_ENCRYPTION_KEY=
# 用于签名公开分享链接，至少 32 个随机字符，不得与加密密钥复用。
SHARE_LINK_SIGNING_KEY=
# LinuxDo Connect 的客户端 ID，填写后才会启用 LinuxDo 登录。
LINUXDO_CLIENT_ID=
# LinuxDo Connect 的客户端密钥。
LINUXDO_CLIENT_SECRET=
# LinuxDo Connect OAuth 回调地址，必须与服务商后台配置完全一致。
LINUXDO_REDIRECT_URI=
# 服务端登录会话有效期，例如 336h 表示 14 天。
AUTH_SESSION_TTL=336h
# 是否启用安全 Cookie；使用 HTTPS 部署时应设为 true。
AUTH_COOKIE_SECURE=false
