# 服务端
PORT=8081
GIN_MODE=debug

# 认证
# 邮箱登录、注册、验证码、邀请码和 SMTP 均在管理员页面维护。
# 用于加密数据库中的 SMTP 密码，至少 32 个随机字符；生产环境必须设置且不可随意更换。
AUTH_DATA_ENCRYPTION_KEY=
# LinuxDo Connect OAuth（三项均填写后「LinuxDo 登录」才会启用）
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# 必须与 LinuxDo 应用后台登记的回调地址完全一致。
# 本地开发通常为 http://localhost:5173/api/auth/linuxdo/callback
LINUXDO_REDIRECT_URI=
AUTH_SESSION_TTL=336h
# HTTPS 部署必须为 true；本地 HTTP 开发保持 false。
AUTH_COOKIE_SECURE=false

# PostgreSQL 连接（由你手动接入）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fatecraft?sslmode=disable

# 后端数据文件根目录（判定配置、响应 Schema、空库首次启动的内置挑战材料）
# 相对路径基于后端工作目录，默认 backend/data/；已有挑战内容时不会再次导入或覆盖。
DATA_DIR=data

# LLM 默认值（数据库 llm_settings 行存在时会覆盖这里）。
# 当数据库行的 api_key 为空时，使用这里的 key 作为兜底。
LLM_API_KEY=

# 允许的 CORS/WebSocket 来源（逗号分隔）；留空则全放开，仅开发用，生产必须配置
ALLOWED_ORIGINS=

# 日志：级别 debug/info/warn/error；格式 console（开发彩色）/ json（生产结构化）
LOG_LEVEL=info
LOG_FORMAT=console
