# Docker 开发环境配置。
# 默认连接 compose 内置 PostgreSQL；复用外部实例时改 POSTGRES_HOST 与 DATABASE_URL。
# 本机敏感覆盖写到 backend.development.env.local（已被 git 忽略）。

# Postgres（postgresql 服务初始化与备份 sidecar 使用）
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=fatecraft
POSTGRES_USER=fatecraft
POSTGRES_PASSWORD=fatecraft-dev
POSTGRES_SSLMODE=disable

# 后端
PORT=8081
GIN_MODE=debug
DATABASE_URL=postgres://fatecraft:fatecraft-dev@postgresql:5432/fatecraft?sslmode=disable
DATA_DIR=data

# 认证（敏感值写入 backend.development.env.local）
# 邮箱认证策略在管理员页面维护；此密钥用于加密 SMTP 密码。
AUTH_DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# 宿主机前端开发服务的回调地址（必须登记到 LinuxDo Connect）
LINUXDO_REDIRECT_URI=http://localhost:5173/api/auth/linuxdo/callback
AUTH_SESSION_TTL=336h
AUTH_COOKIE_SECURE=false

# LLM 兜底密钥（也可启动后在前端「设置」页配置）
LLM_API_KEY=
