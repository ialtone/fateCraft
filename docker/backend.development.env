# Docker 开发环境配置。
# 默认连接 compose 内置 PostgreSQL；复用外部实例时改 POSTGRES_HOST 与 DATABASE_URL。
# 本机敏感覆盖写到 backend.development.env.local（已被 git 忽略）。

# Postgres（postgresql 服务初始化与备份 sidecar 使用）
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=fatecraft
POSTGRES_USER=fatecraft
POSTGRES_PASSWORD=fatecraft-dev
POSTGRES_SSLMODE=disable

# 后端
PORT=8081
GIN_MODE=debug
DEV_PLAYER_ID=dev
DATABASE_URL=postgres://fatecraft:fatecraft-dev@postgresql:5432/fatecraft?sslmode=disable
AUTO_MIGRATE=false
DATA_DIR=data

# LLM 兜底密钥（也可启动后在前端「设置」页配置）
LLM_API_KEY=
