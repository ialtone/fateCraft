# Release tag to deploy, for example 1.0.0. Use latest only for testing.
FATECRAFT_VERSION=1.0.0

# Copy backend.production.env to backend.production.env.local and set secrets there.
FATECRAFT_ENV_FILE=./backend.production.env.local

# Override only when using a fork or a registry mirror.
FATECRAFT_IMAGE_PREFIX=ghcr.io/ialtone
