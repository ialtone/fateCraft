# ==================== Docker 生产环境 ====================
# 部署前务必修改数据库密码，并同步更新 DATABASE_URL。
# 敏感值应写入 backend.production.env.local，该文件已被 Git 忽略。

# ==================== PostgreSQL 容器 ====================
# PostgreSQL 容器的服务名。
POSTGRES_HOST=postgresql
# PostgreSQL 容器端口。
POSTGRES_PORT=5432
# PostgreSQL 数据库名。
POSTGRES_DB=fatecraft
# PostgreSQL 数据库用户。
POSTGRES_USER=fatecraft
# PostgreSQL 数据库密码。
POSTGRES_PASSWORD=change-me
# PostgreSQL SSL 模式。
POSTGRES_SSLMODE=disable

# ==================== 后端服务 ====================
# 后端 HTTP 服务监听端口。
PORT=8081
# Gin 运行模式。
GIN_MODE=release
# 后端连接 PostgreSQL 的数据库地址。
DATABASE_URL=postgres://fatecraft:change-me@postgresql:5432/fatecraft?sslmode=disable
# 后端数据文件根目录。
DATA_DIR=data
# 已发布挑战只读内容缓存上限；2C4G 建议 16 个版本、256 MiB。
CHALLENGE_CACHE_MAX_VERSIONS=16
CHALLENGE_CACHE_MAX_MIB=256

# ==================== 认证与安全 ====================
# 用于加密数据库中的用户/平台 LLM API Key 和 SMTP 密码，至少填写 32 个字符。
AUTH_DATA_ENCRYPTION_KEY=
# 用于签名公开分享链接，至少 32 个随机字符且不得与其他密钥复用。
SHARE_LINK_SIGNING_KEY=
# LinuxDo Connect 的客户端 ID。
LINUXDO_CLIENT_ID=
# LinuxDo Connect 的客户端密钥。
LINUXDO_CLIENT_SECRET=
# 生产站点的 HTTPS 回调地址，必须与 LinuxDo Connect 后台配置完全一致。
LINUXDO_REDIRECT_URI=https://your-domain.example/api/auth/linuxdo/callback
# 服务端登录会话有效期。
AUTH_SESSION_TTL=336h
# 是否启用安全 Cookie；生产 HTTPS 部署应设为 true。
AUTH_COOKIE_SECURE=true
