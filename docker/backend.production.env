# Docker 生产环境配置。
# 部署前务必修改 POSTGRES_PASSWORD 并同步更新 DATABASE_URL。
# 敏感覆盖写到 backend.production.env.local（已被 git 忽略）。

# Postgres（postgresql 服务初始化与备份 sidecar 使用）
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=fatecraft
POSTGRES_USER=fatecraft
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=disable

# 后端
PORT=8081
GIN_MODE=release
DATABASE_URL=postgres://fatecraft:change-me@postgresql:5432/fatecraft?sslmode=disable
DATA_DIR=data

# 认证（务必写入 backend.production.env.local，勿把真实凭据提交到仓库）
# 邮箱认证策略在管理员页面维护；真实密钥写入本地覆盖文件且不可随意更换。
AUTH_DATA_ENCRYPTION_KEY=
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# 替换为生产站点实际 HTTPS 地址，并在 LinuxDo Connect 后台登记完全相同的值。
LINUXDO_REDIRECT_URI=https://your-domain.example/api/auth/linuxdo/callback
AUTH_SESSION_TTL=336h
AUTH_COOKIE_SECURE=true

# LLM 兜底密钥（也可启动后在前端「设置」页配置）
LLM_API_KEY=
