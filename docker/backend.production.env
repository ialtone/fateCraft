# Docker 生产环境配置。
# 部署前务必修改 POSTGRES_PASSWORD 并同步更新 DATABASE_URL。
# 敏感覆盖写到 backend.production.env.local（已被 git 忽略）。

# Postgres（postgresql 服务初始化与备份 sidecar 使用）
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=fatecraft
POSTGRES_USER=fatecraft
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=disable

# 后端
PORT=8081
GIN_MODE=release
DEV_PLAYER_ID=dev
DATABASE_URL=postgres://fatecraft:change-me@postgresql:5432/fatecraft?sslmode=disable
AUTO_MIGRATE=false
DATA_DIR=data

# LLM 兜底密钥（也可启动后在前端「设置」页配置）
LLM_API_KEY=
