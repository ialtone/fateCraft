# fateCraft Linux 部署配置示例
# 复制为 .env 后修改。服务启动时会从当前工作目录读取 .env。

PORT=8081
GIN_MODE=release
TZ=Asia/Shanghai

# PostgreSQL 连接地址。请同步修改用户名、密码和数据库名。
DATABASE_URL=postgres://fatecraft:change-me@127.0.0.1:5432/fatecraft?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=3
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# fatecraft-migrate 使用的迁移超时。
MIGRATION_CONNECT_TIMEOUT=10s
MIGRATION_TIMEOUT=10m

# 内置玩法包、Schema 和初始数据所在目录。
DATA_DIR=data

# 同源部署时留空。前后端跨域部署时填写允许的来源，多个值用英文逗号分隔。
ALLOWED_ORIGINS=
# 仅信任本机 Nginx 传来的代理头；后端端口不要直接暴露到公网。
TRUSTED_PROXIES=127.0.0.1,::1

# 实例标识。留空时使用“主机名:端口”。单机部署保持默认即可。
INSTANCE_ID=
MEMORY_WORKER_CONCURRENCY=4
CHALLENGE_CACHE_MAX_VERSIONS=16
CHALLENGE_CACHE_MAX_MIB=256

LOG_LEVEL=info
LOG_FORMAT=console

# 加密数据库中的用户和平台 LLM API Key，至少 32 个字符。
# 生成示例：openssl rand -base64 32
AUTH_DATA_ENCRYPTION_KEY=
# 分享链接签名密钥，至少 32 个字符，不要与上一项共用。
SHARE_LINK_SIGNING_KEY=

# LinuxDo Connect 登录，未配置时该登录方式不可用。
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=

# 登录会话有效期。
AUTH_SESSION_TTL=336h
# 使用 HTTPS 时设为 true。
AUTH_COOKIE_SECURE=false
